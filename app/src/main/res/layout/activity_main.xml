<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070B18">
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Roxy wallpaper preview" android:scaleType="centerCrop" android:src="@drawable/roxy_wallpaper"/><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#55030A19"/><com.otakuhoarder.mushokufoldroxy.MagicOverlayView android:id="@+id/magicOverlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="22dp" android:paddingTop="42dp" android:paddingRight="22dp" android:paddingBottom="32dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MUSHOKUFOLD" android:textColor="#BFEFFF" android:textSize="13sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROXY CONTROL CENTER" android:textColor="#FFFFFF" android:textSize="29sp" android:textStyle="bold"/><TextView android:id="@+id/deviceState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#990A1830" android:padding="10dp" android:textColor="#CDEFFF" android:textSize="13sp"/><Space android:layout_width="1dp" android:layout_height="230dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#E00A1327" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE MANA WALLPAPER" android:textColor="#8DDFFF" android:textSize="12sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Roxy • Motion Reactive" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Five Roxy scenes with responsive parallax, ambient mana and magical scene transitions." android:textColor="#C5D8EE" android:textSize="13sp"/><Button android:id="@+id/liveWallpaper" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Preview &amp; Apply Live Roxy"/><Button android:id="@+id/magicPulse" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Cast Mana Pulse"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#D90A1327" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROXY ROTATION" android:textColor="#8DDFFF" android:textSize="12sp" android:textStyle="bold"/><Switch android:id="@+id/rotationSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Rotate Roxy scenes automatically" android:textColor="#FFFFFF"/><TextView android:id="@+id/rotationStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B9CBE3" android:textSize="13sp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#D90A1327" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STATIC ROXY" android:textColor="#8DDFFF" android:textSize="12sp" android:textStyle="bold"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><Button android:id="@+id/applyHome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Home"/><Button android:id="@+id/applyLock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_weight="1" android:text="Lock"/><Button android:id="@+id/applyBoth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_weight="1" android:text="Both"/></LinearLayout></LinearLayout>
<TextView android:id="@+id/versionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#9AB1CE" android:textSize="12sp"/>
</LinearLayout></ScrollView></FrameLayout>